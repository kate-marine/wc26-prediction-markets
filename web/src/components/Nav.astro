---
const links = [
  { href: "/", label: "Home" },
  { href: "/explore", label: "Explore" },
];
const current = Astro.url.pathname;
---

<header class="site-nav">
  <a class="site-nav__brand" href="/">WC26 Prediction Markets</a>
  <nav>
    <ul>
      {
        links.map((link) => (
          <li>
            <a href={link.href} aria-current={current === link.href ? "page" : undefined}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
